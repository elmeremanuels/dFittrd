auto-install-peers=true
strict-peer-dependencies=false
# One package at a time for every `pnpm -r` run, here and on CI: with four packages testing side by side on a 4-core
# runner, the CPU-bound cloth and fit tests starved vitest (a 5 s test time-out in fit-engine, then
# "[vitest-worker] Timeout calling onTaskUpdate" in garment-viewer with every test passing).
workspace-concurrency=1
