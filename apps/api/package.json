{
  "name": "@curtain/api",
  "version": "0.1.0",
  "description": "Curtain backend: the one Fastify process that is the app API, merchant API, SDK host, Shopify app backend, Stripe billing and the pg-boss job runner.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "browser": false,
  "main": "./dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "demo": "tsx src/demo.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/migrate.js && node dist/server.js",
    "migrate": "node dist/migrate.js",
    "asset:import": "tsx src/scripts/import-asset.ts",
    "shopify:schema": "tsx src/scripts/fetch-admin-schema.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/cors": "11.4.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "@curtain/schema": "workspace:*",
    "@curtain/sdk": "workspace:*",
    "@curtain/shopify-app": "workspace:*",
    "@curtain/tryon-providers": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.15",
    "pg-boss": "12.38.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5.6",
    "drizzle-kit": "0.31.11",
    "graphql": "16.12.0",
    "eslint": "^9.39.5",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
