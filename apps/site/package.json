{
  "name": "@curtain/site",
  "private": true,
  "version": "0.1.0",
  "description": "curtain.fit marketing site: static HTML generated at build time, no tracking, self-hosted fonts and images.",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:release": "CURTAIN_SITE_RELEASE=1 tsx scripts/build.ts",
    "dev": "tsx scripts/build.ts && vite preview --outDir dist --port 4321 --host 0.0.0.0",
    "preview": "vite preview --outDir dist --port 4321 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src scripts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@types/node": "^22.14.0",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.72.1",
    "vite": "^6.2.3"
  }
}
