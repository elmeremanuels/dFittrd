{
  "name": "@paskamer/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/gen-icons.mjs && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src e2e",
    "e2e": "node scripts/gen-icons.mjs && vite build && playwright test -c e2e/playwright.config.ts",
    "models": "node src/features/capture/scripts/fetch-models.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@mediapipe/tasks-vision": "1.2.2",
    "@paskamer/fit-engine": "workspace:*",
    "@paskamer/schema": "workspace:*",
    "@paskamer/taste-engine": "workspace:*",
    "dexie": "4.4.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router": "7.18.5",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "jsdom": "27.4.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.72.1",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^3.2.4",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
