# Curtain — infra/.env (copy to infra/.env; never commit). Read by docker-compose.yml and, inside the
# api container, by apps/api/src/env.ts — the ONLY place secrets are read (AGENTS.md rule 2).
# Generate secrets with:  openssl rand -hex 32

# ---- edge / compose -----------------------------------------------------------------------
DOMAIN=curtain.fit                 # serves app.<DOMAIN> and api.<DOMAIN>
ACME_EMAIL=founder@example.com      # Let's Encrypt contact
API_IMAGE=ghcr.io/<github-owner>/curtain-api:latest   # as pushed by .github/workflows/ci.yml (image name curtain-api)
POSTGRES_USER=curtain
POSTGRES_PASSWORD=                  # required
POSTGRES_DB=curtain

# ---- api: required secrets -----------------------------------------------------------------
JWT_SECRET=                         # ≥ 32 chars; signs device JWTs, try tokens, render URLs
SHOP_KEY_PEPPER=                    # pepper for pseudonyms + merchant key hashes
ENCRYPTION_KEY=                     # 64 hex chars (32 bytes): AES-256-GCM for Shopify tokens + merchant HMAC secrets

# ---- api: runtime --------------------------------------------------------------------------
LOG_LEVEL=info                      # fatal|error|warn|info|debug|trace|silent
LOG_IPS=0                           # keep 0: no client IP is ever logged (docker log rotation keeps ~7 days)
JOBS=both                           # both | 1 (jobs-only replica, no HTTP) | 0 (HTTP only, no workers)
CORS_ORIGINS=                       # extra app origins, comma-separated (the SDK route is always *)
K_ANON=5                            # k-anonymity floor for merchant aggregates and cohorts (raise after pilots)
DEVICE_TOKEN_TTL_DAYS=30
TRY_TOKEN_TTL_SEC=600
SDK_RATE_LIMIT_PER_MIN=120          # POST /v1/sdk/sessions per shop key per minute
TRY_RATE_LIMIT_PER_MIN=60           # GET /v1/try/:token and POST …/fit-shown per client IP per minute
EMBED_BILLED_SESSIONS_PER_DAY=5000  # anomaly cap: standalone sessions billed per shop per UTC day
BILLED_DAILY_CAP_FACTOR=10          # per-shop daily cap = max(MIN, plan's average day × FACTOR), never above EMBED_BILLED_SESSIONS_PER_DAY
BILLED_DAILY_CAP_MIN=100            # free 100, starter 167, pro 1667 billed fit sessions per day with these defaults
BILLING_ANOMALY_FACTOR=3            # a day above FACTOR × trailing average is recorded as a spike (signal only)
BILLING_ANOMALY_MIN_SESSIONS=20     # ...and only once the day has at least this many billed sessions
BILLING_ANOMALY_TRAILING_DAYS=14
DEVICE_CREATE_RATE_LIMIT_PER_HOUR=300 # POST /v1/devices per IP per hour (embed shoppers share NAT IPs; billing has its own caps)
DEVICE_TOKEN_ROTATE_GRACE_DAYS=180  # an expired device token may still rotate this long; mirrored by ROTATE_GRACE_MS in apps/web
MEDIA_PROXY_MAX_BYTES=5242880       # GET /v1/sdk/media: largest image served (shop logo / product photo)
MEDIA_PROXY_CACHE_MB=64             # in-memory LRU per api process
MEDIA_PROXY_CACHE_TTL_SEC=3600
MEDIA_PROXY_RATE_LIMIT_PER_MIN=240  # per IP
WOO_DOMAIN_PROOF=1                  # manual-key Woo Connect must prove the domain; 0 only for a local WordPress on a private address
# SDK_FILE=/app/node_modules/@curtain/sdk/dist/sdk.v1.js   # override the served SDK bundle

# ---- hero render / AI providers (D4) ---------------------------------------------------------
RENDERS_DIR=/data/renders           # local volume; results pruned after RENDER_RETENTION_HOURS
RENDER_RETENTION_HOURS=24           # max 24
TRYON_ORDER=fashn,mock              # provider preference: fashn | fashn-max | vertex-tryon | grok-video | mock
TRYON_MAX_COST_USD=0.5              # per render
TRYON_DAILY_CAP_USD=25              # per UTC day, all providers
TRYON_REQUIRE_EU=0                  # 1 → skip providers without confirmed EU processing
FASHN_API_KEY=                      # fa-…
FASHN_EU_RESIDENCY_CONFIRMED=0      # set 1 only after the DPA confirms EU processing
VERTEX_TRYON_ENABLED=0
VERTEX_PROJECT=
VERTEX_LOCATION=europe-west4
# VERTEX_ACCESS_TOKEN=              # dev only; production uses the GCE/Cloud Run metadata server
XAI_API_KEY=                        # xai-… (hero video; US-only processing)
XAI_ZDR=0

# ---- Shopify app (D6, managed installation) ---------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-10              # = DEFAULT_API_VERSION in packages/shopify-app/src/types.ts (latest stable, Nov 2026); bump both together
SHOPIFY_SCOPES=read_products,write_products
SHOPIFY_APP_HANDLE=curtain            # must equal `handle` in shopify.app.<env>.toml

# ---- Stripe (WooCommerce merchants) --------------------------------------------------------
STRIPE_SECRET=                      # sk_live_… — leave empty to use the manual-key Connect path
STRIPE_WEBHOOK_SECRET=              # whsec_…
STRIPE_PRICE_STARTER=               # price_… (recurring, €29/mo)
STRIPE_PRICE_OVERAGE=               # price_… (metered, €0.05/session)

# ---- backups (scripts/backup.sh) --------------------------------------------------------------
BACKUP_AGE_RECIPIENT=               # age1… public key; the private key never lives on the VPS
BACKUP_RCLONE_REMOTE=               # e.g. hetzner:curtain-backups
BACKUP_KEEP_DAYS=30
