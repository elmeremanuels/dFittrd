# Curtain edge: app.<domain> = static PWA (SPA fallback, COOP/COEP for MediaPipe wasm threads),
# api.<domain> = reverse proxy to the api container. Automatic Let's Encrypt via Caddy.
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}
}

app.{$DOMAIN} {
	import security_headers
	root * /srv/web
	encode zstd gzip

	header {
		# Cross-origin isolation: SIMD + threads for the MediaPipe wasm (D5). Assets carry CORP so they stay loadable.
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
		# Zero third-party requests: fonts, models and the SDK come from our origins; connect only to the api.
		Content-Security-Policy "default-src 'self'; connect-src 'self' https://api.{$DOMAIN}; img-src 'self' data: blob: https:; media-src 'self' blob: https://api.{$DOMAIN}; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	@immutable path /assets/* /models/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@nocache path /index.html /sw.js /manifest.webmanifest
	header @nocache Cache-Control "no-cache"

	# SPA fallback: /try/<token>, /merchant, … all resolve to index.html
	try_files {path} /index.html
	file_server
}

api.{$DOMAIN} {
	import security_headers
	encode zstd gzip

	# The merchant SDK is cached for an hour and may be embedded cross-origin (merchant pages).
	@sdk path /sdk/v1.js
	header @sdk Cache-Control "public, max-age=3600"
	header @sdk Cross-Origin-Resource-Policy "cross-origin"

	# Signed render URLs are fetched by the PWA (cross-origin) as <img>/<video>.
	@renders path /v1/renders/*
	header @renders Cross-Origin-Resource-Policy "cross-origin"

	reverse_proxy api:3000 {
		header_up X-Forwarded-Proto {scheme}
		transport http {
			read_timeout 120s
		}
	}
}
