# Curtain edge: <domain> = the static marketing site (apps/site, docs/SITE.md), www.<domain> = redirect to it,
# app.<domain> = static PWA (SPA fallback, COOP/COEP for MediaPipe wasm threads),
# api.<domain> = reverse proxy to the api container. Automatic Let's Encrypt via Caddy.
{
	email {$ACME_EMAIL}
}

(base_headers) {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}
}

(security_headers) {
	import base_headers
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# The marketing site (apps/site): plain static HTML published into the site volume by
# infra/scripts/deploy.sh (--site-release). No cookies, no third parties: everything is same-origin.
# Until the first site release is published the volume is empty and every path answers 404.
{$DOMAIN} {
	# HSTS here does not extend to subdomains: from the apex that would cover every *.<domain>, including the
	# mail and webmail hostnames of the hello@ mailbox, which this stack does not serve.
	import base_headers
	header Strict-Transport-Security "max-age=31536000"
	root * /srv/site
	encode zstd gzip

	# One URL per page: /pilot -> /pilot/ (only where that directory page exists), so the HTML cache
	# header below always applies and no page is served at two addresses.
	@noslash {
		not path */
		file {path}/index.html
	}
	redir @noslash {path}/ 308

	header {
		# style-src-attr only for the image crops (object-position attributes); the waitlist form opens mailto:.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; style-src-attr 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
	}

	# Content-hashed CSS/JS; the self-hosted fonts only ever change with a new file name.
	@immutable path /assets/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	# Images keep their names when replaced (a partner photo may need to come down quickly): one day.
	@img path /img/*
	header @img Cache-Control "public, max-age=86400"
	@static path /og.jpg /favicon.svg /apple-touch-icon.png /robots.txt /sitemap.xml
	header @static Cache-Control "public, max-age=3600"
	# HTML is revalidated on every visit, so a new release shows at once.
	@html path / *.html */
	header @html Cache-Control "no-cache"

	try_files {path} {path}/index.html
	file_server

	# "Wrong size.": the site's own 404 page, still with status 404.
	handle_errors 404 {
		rewrite * /404.html
		header Cache-Control "no-cache"
		file_server
	}
}

www.{$DOMAIN} {
	import security_headers
	redir https://{$DOMAIN}{uri} permanent
}

app.{$DOMAIN} {
	import security_headers
	root * /srv/web
	encode zstd gzip

	# /embed/<token> is the ONLY framable route (docs/STANDALONE.md §2, D11): the standalone overlay
	# that merchant pages load in an <iframe>. The try token, not the frame, is the access control.
	@embed path /embed /embed/*
	@app not path /embed /embed/*

	header @app {
		# Cross-origin isolation: SIMD + threads for the MediaPipe wasm (D5). Assets carry CORP so they stay loadable.
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
		# Zero third-party requests: fonts, models and the SDK come from our origins; connect only to the api.
		# img-src: merchant logos and product photos load through the api media proxy (GET /v1/sdk/media,
		# carry-over #11) and hero renders from signed api URLs; data:/blob: are the avatar, the face tile
		# and the rasterised avatar. No other https host is needed.
		Content-Security-Policy "default-src 'self'; connect-src 'self' https://api.{$DOMAIN}; img-src 'self' data: blob: https://api.{$DOMAIN}; media-src 'self' blob: https://api.{$DOMAIN}; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	header @embed {
		# Framable by any https shop. No X-Frame-Options (it would override frame-ancestors in old browsers).
		-X-Frame-Options
		# No COOP: it only applies to top-level documents and would cut the opener link if opened in a tab.
		-Cross-Origin-Opener-Policy
		# A shop that runs COEP itself can still frame us; the document is meant to be embedded cross-origin.
		Cross-Origin-Resource-Policy "cross-origin"
		# credentialless instead of require-corp. The product photo now comes through the api media
		# proxy (which sends CORP cross-origin), so require-corp would also work; credentialless is kept
		# as the safer default. Inside a non-isolated merchant page the iframe is never cross-origin
		# isolated anyway, so MediaPipe falls back to its non-threaded wasm here.
		Cross-Origin-Embedder-Policy "credentialless"
		Content-Security-Policy "default-src 'self'; connect-src 'self' https://api.{$DOMAIN}; img-src 'self' data: blob: https://api.{$DOMAIN}; media-src 'self' blob: https://api.{$DOMAIN}; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; frame-ancestors https:; base-uri 'self'; form-action 'self'"
		# The embed shows a product page and a size; keep it out of shared caches and search engines.
		Cache-Control "no-store"
		X-Robots-Tag "noindex"
	}

	@immutable path /assets/* /models/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@nocache path /index.html /sw.js /manifest.webmanifest
	header @nocache Cache-Control "no-cache"

	# SPA fallback: /try/<token>, /embed/<token>, /merchant, … all resolve to index.html
	try_files {path} /index.html
	file_server
}

api.{$DOMAIN} {
	import security_headers
	encode zstd gzip

	# The merchant SDK is cached for an hour and may be embedded cross-origin (merchant pages).
	@sdk path /sdk/v1.js
	header @sdk Cache-Control "public, max-age=3600"
	header @sdk Cross-Origin-Resource-Policy "cross-origin"

	# Signed render URLs are fetched by the PWA (cross-origin) as <img>/<video>.
	@renders path /v1/renders/*
	header @renders Cross-Origin-Resource-Policy "cross-origin"

	# Approved garment bundles (D16): public product data, immutable per version, served from the
	# assets volume (the api writes it, Caddy only reads). Fetched by the /embed iframe after the
	# shopper opts in to the 3D estimate: no cookies, no query strings, no access log.
	handle_path /assets/* {
		@bad not path_regexp ^/[0-9a-f-]{36}/[0-9a-f-]{36}/[0-9a-f]{16}/(base\.glb|anchors\.json|grading\.json|material\.json|qa\.json)$
		respond @bad 404
		@query expression {query} != ""
		respond @query 404
		header Cache-Control "public, max-age=31536000, immutable"
		header Cross-Origin-Resource-Policy "cross-origin"
		header Access-Control-Allow-Origin "https://app.{$DOMAIN}"
		header -Set-Cookie
		log_skip
		root * /srv/assets
		file_server
	}

	reverse_proxy api:3000 {
		header_up X-Forwarded-Proto {scheme}
		transport http {
			read_timeout 120s
		}
	}
}
