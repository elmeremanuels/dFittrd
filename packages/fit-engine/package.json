{
  "name": "@curtain/fit-engine",
  "version": "0.1.0",
  "description": "Curtain fit engine v1: pure, deterministic computeFit / recommendSize (handoff §4.1–4.2, docs/research/fit-engine-spec.md). Runs on-device; zero runtime dependencies.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/check-no-runtime-imports.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@curtain/schema": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@curtain/schema": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
