{
  "name": "@curtain/sdk",
  "version": "0.1.0",
  "description": "Curtain merchant SDK: a tiny vanilla-JS drop-in that turns <button data-curtain-product> into the standalone try-on overlay on the shop page (or, in app mode, the deep link / QR handshake).",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": true,
  "browser": true,
  "main": "./dist/sdk.v1.js",
  "module": "./dist/sdk.v1.esm.js",
  "types": "./dist/sdk.v1.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk.v1.d.ts",
      "import": "./dist/sdk.v1.esm.js",
      "default": "./dist/sdk.v1.js"
    },
    "./sdk.v1.js": "./dist/sdk.v1.js",
    "./sdk.v1.esm.js": "./dist/sdk.v1.esm.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/check-size.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@curtain/schema": "workspace:*",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "jsdom": "^27.4.0",
    "jsqr": "^1.4.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
