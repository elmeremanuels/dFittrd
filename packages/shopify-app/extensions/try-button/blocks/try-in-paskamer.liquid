{%- comment -%}
  Try in Paskamer — app block for the product template.

  Renders <button data-paskamer-product="{{ product.id }}"> and loads the bundled SDK
  (assets/sdk.v1.js, copied from @paskamer/sdk at build). The SDK turns the click into
  POST {api}/v1/sdk/sessions → deep link (mobile) or QR modal (desktop). Nothing about the shopper
  reaches the merchant page; the SDK sets no cookies and uses no storage.

  The public shop key (pk_live_…) and the API origin come from app-data metafields the api writes
  on install (app.metafields.paskamer.public_key / api_url). The block settings can override them
  for dev stores. The secret key (sk_…) must never appear here.
{%- endcomment -%}

{%- liquid
  assign pk_shop_key = block.settings.shop_key | strip
  if pk_shop_key == blank
    assign pk_shop_key = app.metafields.paskamer.public_key
  endif
  assign pk_api_url = block.settings.api_url | strip
  if pk_api_url == blank
    assign pk_api_url = app.metafields.paskamer.api_url
  endif
  assign pk_label = block.settings.label | strip
  if pk_label == blank
    assign pk_label = 'paskamer.try_button.label' | t
  endif
  assign pk_locale = request.locale.iso_code | slice: 0, 2 | downcase
  if pk_locale != 'nl'
    assign pk_locale = 'en'
  endif
-%}

{%- if product -%}
  <div class="paskamer-try paskamer-try--{{ block.settings.alignment }}" {{ block.shopify_attributes }}>
    {%- render 'paskamer-try-button', product: product, label: pk_label, show_hint: block.settings.show_hint -%}
  </div>

  {%- if pk_shop_key != blank and pk_api_url != blank -%}
    {%- comment -%}
      Load the SDK once even when the block appears twice (each block renders this guard; the first
      one wins). The tag is created with the data-* attributes the SDK's auto-init reads; data-api is
      mandatory because the asset is served from Shopify's CDN, not from our API origin.
    {%- endcomment -%}
    <script>
      (function () {
        if (window.Paskamer || document.querySelector('script[data-shop][data-paskamer-sdk]')) return;
        var s = document.createElement('script');
        s.src = {{ 'sdk.v1.js' | asset_url | json }};
        s.defer = true;
        s.setAttribute('data-paskamer-sdk', '');
        s.setAttribute('data-shop', {{ pk_shop_key | json }});
        s.setAttribute('data-api', {{ pk_api_url | json }});
        s.setAttribute('data-mode', {{ block.settings.mode | json }});
        s.setAttribute('data-locale', {{ pk_locale | json }});
        s.setAttribute('data-label', {{ pk_label | json }});
        {%- if block.settings.unstyled %}s.setAttribute('data-paskamer-unstyled', '');{% endif %}
        document.head.appendChild(s);
      })();
    </script>
  {%- elsif request.design_mode -%}
    <p class="paskamer-try__setup">{{ 'paskamer.try_button.not_connected' | t }}</p>
  {%- endif -%}
{%- elsif request.design_mode -%}
  <p class="paskamer-try__setup">{{ 'paskamer.try_button.needs_product' | t }}</p>
{%- endif -%}

{% schema %}
{
  "name": "t:paskamer.block.name",
  "target": "content",
  "stylesheet": "paskamer-try.css",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:paskamer.settings.label.label",
      "info": "t:paskamer.settings.label.info"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:paskamer.settings.alignment.label",
      "default": "full",
      "options": [
        { "value": "left", "label": "t:paskamer.settings.alignment.left" },
        { "value": "center", "label": "t:paskamer.settings.alignment.center" },
        { "value": "full", "label": "t:paskamer.settings.alignment.full" }
      ]
    },
    {
      "type": "select",
      "id": "mode",
      "label": "t:paskamer.settings.mode.label",
      "info": "t:paskamer.settings.mode.info",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "t:paskamer.settings.mode.auto" },
        { "value": "redirect", "label": "t:paskamer.settings.mode.redirect" },
        { "value": "modal", "label": "t:paskamer.settings.mode.modal" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_hint",
      "label": "t:paskamer.settings.show_hint.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "unstyled",
      "label": "t:paskamer.settings.unstyled.label",
      "info": "t:paskamer.settings.unstyled.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:paskamer.settings.advanced.header"
    },
    {
      "type": "text",
      "id": "shop_key",
      "label": "t:paskamer.settings.shop_key.label",
      "info": "t:paskamer.settings.shop_key.info"
    },
    {
      "type": "url",
      "id": "api_url",
      "label": "t:paskamer.settings.api_url.label",
      "info": "t:paskamer.settings.api_url.info"
    }
  ]
}
{% endschema %}
