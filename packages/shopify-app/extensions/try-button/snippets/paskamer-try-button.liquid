{%- comment -%}
  The button itself. Also usable from a theme that lacks app-block support:
    {% render 'paskamer-try-button', product: product, label: 'Try in Paskamer', show_hint: true %}
  `data-paskamer-product` carries the numeric product id = the external id the api stores
  (shopifyExternalId of the Product GID).
{%- endcomment -%}
<button
  type="button"
  class="paskamer-try__button"
  data-paskamer-product="{{ product.id }}"
  data-paskamer-variant="{{ product.selected_or_first_available_variant.id }}"
  aria-describedby="paskamer-try-hint-{{ product.id }}"
>
  <svg class="paskamer-try__icon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" focusable="false">
    <path fill="currentColor" d="M7 3h10l1.2 2.4L22 7l-2 4-2-.9V21H6V10.1L4 11 2 7l3.8-1.6L7 3zm2.1 2L8 7.2l-2.8 1.2.8 1.6 2-.9V19h8V9.1l2 .9.8-1.6L16 7.2 14.9 5h-1.2a1.7 1.7 0 0 1-3.4 0H9.1z"/>
  </svg>
  <span>{{ label }}</span>
</button>
{%- if show_hint -%}
  <p id="paskamer-try-hint-{{ product.id }}" class="paskamer-try__hint">{{ 'paskamer.try_button.hint' | t }}</p>
{%- else -%}
  <span id="paskamer-try-hint-{{ product.id }}" class="paskamer-try__sr">{{ 'paskamer.try_button.hint' | t }}</span>
{%- endif -%}
