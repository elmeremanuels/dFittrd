{
  "name": "@curtain/shopify-app",
  "version": "0.1.0",
  "description": "Curtain Shopify app: shopify.app.toml (managed installation + declarative webhooks), the 'Try it on' theme app extension bundling the SDK, the embedded admin page, and the server-side helpers apps/api uses (Admin GraphQL, token exchange, metafield definitions, bulk backfill, billing, webhook HMAC, product sync).",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "browser": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./admin/index.html": "./admin/index.html",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "admin",
    "extensions",
    "shopify.app.toml",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-sdk.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "configure": "node scripts/configure.mjs",
    "shopify": "shopify"
  },
  "dependencies": {
    "@curtain/schema": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@curtain/sdk": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "jsdom": "27.4.0",
    "smol-toml": "^1.9.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
