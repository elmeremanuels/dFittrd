{
  "name": "@paskamer/taste-engine",
  "version": "0.1.0",
  "description": "Paskamer taste engine: pure TypeScript swipe learning (applySwipe, penalty memory, rankDeck/dealNext, Style DNA) and colour harmony (CIELAB, dE2000, 12-season palettes).",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@paskamer/schema": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@paskamer/schema": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
